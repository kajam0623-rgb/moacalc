{
  "name": "dongnebosal",
  "compatibility_date": "2026-09-19",
  // 자체 방문 통계. /api/hit 기록, /admin 대시보드. 나머지는 전부 정적 자산이 그대로 응답한다
  "main": "./worker.js",
  "d1_databases": [
    { "binding": "DB", "database_name": "dongnebosal-stats", "database_id": "dfa75c93-71dc-424b-b2c6-d4c36a0c02a8" }
  ],
  // 매일 한국 시간 새벽 3시: 90일 지난 방문자 구분값 삭제
  "triggers": { "crons": ["0 18 * * *"] },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // 404-page 설정이 있으면 없는 주소는 Worker 대신 404 페이지로 갈 수 있어, 통계 경로만 Worker 가 먼저 받게 못 박는다
    // /namematch.html 은 ?a=&b= 공유 링크의 미리보기 글을 바꾸려고 Worker 가 먼저 받는다(그 쿼리가 없으면 정적 자산 그대로 돌려준다)
    // 별자리·띠 26쪽은 그날의 오늘의 운세 글을 끼우려고 Worker 가 먼저 받는다(와일드카드 해석 차이를 피하려고 주소를 하나씩 적는다)
    "run_worker_first": ["/api/*", "/admin", "/namematch.html", "/gunghap.html",
      "/horoscope.html", "/zodiacfortune.html",
      "/star-aries.html", "/star-taurus.html", "/star-gemini.html", "/star-cancer.html", "/star-leo.html", "/star-virgo.html",
      "/star-libra.html", "/star-scorpio.html", "/star-sagittarius.html", "/star-capricorn.html", "/star-aquarius.html", "/star-pisces.html",
      "/zodiac-rat.html", "/zodiac-ox.html", "/zodiac-tiger.html", "/zodiac-rabbit.html", "/zodiac-dragon.html", "/zodiac-snake.html",
      "/zodiac-horse.html", "/zodiac-goat.html", "/zodiac-monkey.html", "/zodiac-rooster.html", "/zodiac-dog.html", "/zodiac-pig.html"],
    // 기본값(auto-trailing-slash)은 /saju.html 을 /saju 로 돌려보낸다. 캐노니컬이 전부 .html 이라 끈다.
    "html_handling": "none",
    // 없는 주소는 site/404.html 을 404 상태로 보여준다
    "not_found_handling": "404-page"
  },
  // dongnebosal.com 하나로만 서빙 — *.workers.dev 중복 호스트를 만들지 않는다
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "dongnebosal.com", "custom_domain": true }]
}
