{
  "buildCommand": "node build_site.js",
  "outputDirectory": "site",
  "redirects": [
    { "source": "/lotto.html", "destination": "/", "statusCode": 301 },
    { "source": "/draw.html", "destination": "/", "statusCode": 301 },
    { "source": "/ladder.html", "destination": "/", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
